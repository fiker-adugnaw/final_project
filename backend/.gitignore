# ─── Dependencies ─────────────────────────────────────────────
node_modules/
.npm

# ─── Environment Variables (NEVER commit these) ───────────────
.env
.env.local
.env.production
.env.staging
.env.*
!.env.example

# ─── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids/
*.pid

# ─── Local Uploads (use Cloudinary in production) ────────────
uploads/
!uploads/.gitkeep

# ─── Database Backups ─────────────────────────────────────────
database/backups/*.gz
database/backups/*.dump

# ─── Build & Coverage ─────────────────────────────────────────
dist/
build/
coverage/
.nyc_output/

# ─── Editor / IDE ─────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ─── OS Files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Testing ──────────────────────────────────────────────────
.jest-cache/
test-results/

# ─── Misc ─────────────────────────────────────────────────────
*.tgz
.cache/
tmp/
temp/
