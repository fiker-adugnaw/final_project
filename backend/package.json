{
  "name": "ai-legal-assistance-backend",
  "version": "1.0.0",
  "description": "Backend API for the AI-Enabled Legal Assistance and Lawyer Directory Platform — Ethiopia",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "NODE_OPTIONS='--inspect' nodemon server.js",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "seed": "node src/seeders/seedDatabase.js",
    "seed:reset": "node src/seeders/seedDatabase.js --reset",
    "migrate": "node database/migrations/run.js",
    "build": "echo 'No build step required for Node.js backend'",
    "clean": "rimraf logs/ uploads/"
  },
  "keywords": [
    "legal",
    "ethiopia",
    "ai",
    "legal-assistance",
    "lawyer-directory",
    "amharic",
    "legal-aid"
  ],
  "author": "AI Legal Assistance Platform Team",
  "license": "MIT",
  "nodemonConfig": {
    "watch": [
      "src",
      "server.js"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules",
      "uploads",
      "logs",
      "database/backups"
    ],
    "env": {
      "NODE_ENV": "development"
    }
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@joi/date": "^2.1.1",
    "africastalking": "^0.7.9",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.1",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.17.21",
    "mongoose": "^9.3.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^8.0.3",
    "nodemon": "^3.1.14",
    "openai": "^6.32.0",
    "rimraf": "^6.1.3",
    "socket.io": "^4.8.3",
    "twilio": "^5.13.0",
    "uuid": "^13.0.0",
    "validator": "^13.15.26",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4"
  },
  "overrides": {
    "axios": "^1.7.9",
    "lodash": "^4.17.21",
    "validate.js": "^0.13.1"
  }
}
