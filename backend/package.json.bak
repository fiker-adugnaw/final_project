{
  "name": "ai-legal-assistance-backend",
  "version": "1.0.0",
  "description": "Backend API for the AI-Enabled Legal Assistance and Lawyer Directory Platform — Ethiopia",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:debug": "NODE_OPTIONS='--inspect' nodemon server.js",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --ext .js --fix",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit",
    "seed": "node src/seeders/seed.js",
    "seed:reset": "node src/seeders/seed.js --reset",
    "migrate": "node database/migrations/run.js",
    "build": "echo 'No build step required for Node.js backend'",
    "clean": "rimraf logs/ uploads/"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "africastalking": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "joi": "^17.13.3",
    "@joi/date": "^2.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^6.10.0",
    "openai": "^4.85.3",
    "socket.io": "^4.8.1",
    "twilio": "^5.4.3",
    "uuid": "^11.1.0",
    "validator": "^13.12.0",
    "winston": "^3.17.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0"
  },
  "keywords": [
    "legal",
    "ethiopia",
    "ai",
    "legal-assistance",
    "lawyer-directory",
    "amharic",
    "legal-aid"
  ],
  "author": "AI Legal Assistance Platform Team",
  "license": "MIT",
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/seeders/**"
    ],
    "coverageDirectory": "coverage",
    "verbose": true,
    "testTimeout": 30000
  },
  "nodemonConfig": {
    "watch": ["src", "server.js"],
    "ext": "js,json",
    "ignore": ["node_modules", "uploads", "logs", "database/backups"],
    "env": {
      "NODE_ENV": "development"
    }
  }
}
